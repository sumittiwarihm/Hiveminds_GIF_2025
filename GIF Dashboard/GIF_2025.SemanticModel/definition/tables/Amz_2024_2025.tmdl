	partition Amz_2024_2025 = calculated
		mode: import
		source =
				
				
				// 1. Create a daily summary of the Amazon Paid table
				VAR AmazonSummary =
				    ADDCOLUMNS(
				        SUMMARIZE(
				            'public amazon_paid',
				            'public amazon_paid'[date] // Group by date
				        ),
				        "Impressions", CALCULATE(SUM('public amazon_paid'[Impressions])),
				        "Clicks", CALCULATE(SUM('public amazon_paid'[Clicks])),
				        "Spends", CALCULATE(SUM('public amazon_paid'[Spend])),
				        "Orders", CALCULATE(SUM('public amazon_paid'[Orders])),
				        "Sales", CALCULATE(SUM('public amazon_paid'[Sales]))
				        // "Source", "Amazon Paid" // Add a source identifier
				    )
				
				// 2. Select and rename columns from the Sales_2024 table to match
				VAR Sales2024Formatted =
				    SELECTCOLUMNS(
				        'Sale_2024',
				        "date", 'Sale_2024'[GIF], // Rename 'GIF(date)' to 'date'
				        "Impressions", 'Sale_2024'[Impressions],
				        "Clicks", 'Sale_2024'[Clicks],
				        "Spends", 'Sale_2024'[Spends],
				        "Orders", 'Sale_2024'[Orders],
				        "Sales", 'Sale_2024'[Sales]
				        // "Source", "Sales 2024" // Add a source identifier
				    )
				
				// 3. Return the union of the two prepared tables
				RETURN
				UNION(AmazonSummary, Sales2024Formatted)

	annotation PBI_Id = 29c033551eca4a6098d9cc94bd1dbb14

