	partition FinalPriceTable = calculated
		mode: import
		source = ```
				
				GENERATE(
				    'Amazon Price Tracker',
				    VAR CurrentBrand = 'Amazon Price Tracker'[Brand ASIN]
				    VAR CurrentComp = 'Amazon Price Tracker'[Comp 1 ASIN]
				    VAR CurrentDateHourPinList =
				        SELECTCOLUMNS(
				            FILTER(
				                'public amazon_buybox',
				                'public amazon_buybox'[asin] = CurrentBrand || 'public amazon_buybox'[asin] = CurrentComp
				            ),
				            "date", 'public amazon_buybox'[date],
				            "hour", 'public amazon_buybox'[hour],
				            "pin",  'public amazon_buybox'[pin]     -- 👈 include pin
				        )
				    RETURN
				        ADDCOLUMNS(
				            CurrentDateHourPinList,
				            "BrandPrice",
				                CALCULATE(
				                    MAX('public amazon_buybox'[price]),
				                    FILTER(
				                        'public amazon_buybox',
				                        'public amazon_buybox'[asin] = CurrentBrand &&
				                        'public amazon_buybox'[date] = EARLIER([date]) &&
				                        'public amazon_buybox'[hour] = EARLIER([hour]) &&
				                        'public amazon_buybox'[pin]  = EARLIER([pin])   -- 👈 match pin
				                    )
				                ),
				            "CompetitorPrice",
				                CALCULATE(
				                    MAX('public amazon_buybox'[price]),
				                    FILTER(
				                        'public amazon_buybox',
				                        'public amazon_buybox'[asin] = CurrentComp &&
				                        'public amazon_buybox'[date] = EARLIER([date]) && 
				                        'public amazon_buybox'[hour] = EARLIER([hour]) &&
				                        'public amazon_buybox'[pin]  = EARLIER([pin])   -- 👈 match pin
				                    )
				                )
				        )
				)
				
				```

	annotation PBI_Id = b837bb67f9344468a9a73f0ac9a94c2a

