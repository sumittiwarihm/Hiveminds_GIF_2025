	column Brand_Status = ```
			
			SWITCH(
			    TRUE(),
			    SEARCH("jockey", LOWER('public amazon_sov'[title]), 1, 0) > 0, "Brand",
			    "Other"
			)
			
			
			```
		lineageTag: f43d14bc-4473-4696-8a79-eef32cb20600
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Combined_Account_Keyword = ```
			FORMAT('public amazon_sov'[account], "") & " - " & FORMAT('public amazon_sov'[keyword], "")
			
