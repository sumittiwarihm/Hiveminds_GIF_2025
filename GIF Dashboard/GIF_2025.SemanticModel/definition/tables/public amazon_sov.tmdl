	column 'Good Rank' =
			
			IF (
			    'public amazon_sov'[is_sponsored] = "Sponsored" && 'public amazon_sov'[slot] < 5,
			    "Yes",
			    "No"
			)
		lineageTag: b85315f5-a47f-4911-a7cb-31e729f31ef2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column brand_vs_comp = ```
			
			IF (
			 LOWER('public amazon_sov'[brand]) = "jockey",
			    "Brand",
			    "Comp"
			)
			
			```
		lineageTag: 6842fd2b-8538-4e01-81a8-5a36daba2bf6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'public amazon_sov' = m
		mode: import
		source =
				let
				    Source = Table.SelectRows(
				    PostgreSQL.Database("nucleus.ckojnefw0d56.us-west-1.rds.amazonaws.com", "GIF_2025"){[Schema="public", Item="amazon_sov"]}[Data],
				    each [account] = "Jockey"
				)
				in
				    Source

