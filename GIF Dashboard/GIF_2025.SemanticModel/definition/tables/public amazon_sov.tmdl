table 'public amazon_sov'
	lineageTag: 87221efa-84ed-43ef-a2d1-0e9021c06b5d

	measure 'Total Sponsored Slots' =
			
			CALCULATE (
			    COUNTROWS ( 'public amazon_sov' ),
			    'public amazon_sov'[is_sponsored] = "Sponsored"
			)
		formatString: 0
		lineageTag: 7278f0e7-3d0a-430a-a324-17e24b5e59e3

	measure 'Total Organic Slots' =
			
			CALCULATE (
			    COUNTROWS ( 'public amazon_sov' ),
			    'public amazon_sov'[is_sponsored] = "Organic"
			)
		formatString: 0
		lineageTag: fc4b61da-e2cf-4c74-afaf-4b0baeaa351f

	measure 'Total Slots' = COUNTROWS ( 'public amazon_sov' )
		formatString: 0
		lineageTag: 6b5ca8ff-c0a3-43d5-b121-39b2e96f0fe1

	measure 'SoV % Overall' =
			
			DIVIDE (
			    COUNTROWS ( 'public amazon_sov' ),
			    CALCULATE (
			        COUNTROWS ( 'public amazon_sov'),
			        ALL ( 'public amazon_sov'[brand_vs_comp] )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 22d1d114-b5c7-48cc-9537-71b811106798

