	partition Fk_2024_2025 = calculated
		mode: import
		source =
				
				
				// 1. Create a daily summary of the Amazon Paid table
				VAR AmazonSummary =
				    ADDCOLUMNS(
				        SUMMARIZE(
				            'HIVEMINDS_FLIPKART_HOURLY_VIEW',
				            'HIVEMINDS_FLIPKART_HOURLY_VIEW'[DATE] // Group by date
				        ),
				        "Impressions", CALCULATE(SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[VIEWS])),
				        "Clicks", CALCULATE(SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[CLICKS])),
				        "Spends", CALCULATE(SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[AD_SPEND])),
				        "Orders", CALCULATE(SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[TOTAL_ORDERS])),
				        "Sales", CALCULATE(SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[TOTAL_REVENUE]))
				        // "Source", "Amazon Paid" // Add a source identifier
				    )
				
				// 2. Select and rename columns from the Sales_2024 table to match
				VAR Sales2024Formatted =
				    SELECTCOLUMNS(
				        'Sale_2024-Fk',
				        "date", 'Sale_2024-Fk'[BBD], // Rename 'GIF(date)' to 'date'
				        "Impressions", 'Sale_2024-Fk'[Impressions],
				        "Clicks", 'Sale_2024-Fk'[Clicks],
				        "Spends", 'Sale_2024-Fk'[Spends],
				        "Orders", 'Sale_2024-Fk'[Orders],
				        "Sales", 'Sale_2024-Fk'[Sales]
				        // "Source", "Sales 2024" // Add a source identifier
				    )
				
				// 3. Return the union of the two prepared tables
				RETURN
				UNION(AmazonSummary, Sales2024Formatted)

	annotation PBI_Id = 849e31a4b18446839014739ac4a34212

