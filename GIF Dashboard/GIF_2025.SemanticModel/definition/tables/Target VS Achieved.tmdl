	measure '% change_spends_tva' =
			
			VAR BaselineSpends = SUM ('Target VS Achieved'[Spends] )
			VAR ComparisonSpends =
			    CALCULATE (
			        SUM ( 'public amazon_paid'[Spend] )
			    )
			VAR Result =
			    DIVIDE (
			        ComparisonSpends,
			        BaselineSpends,
			        0
			    )
			RETURN
			    Result
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 89493c04-690c-401e-818b-fc2939673f75

	measure actual_clicks = CALCULATE(SUM('public amazon_paid'[Clicks]))
