	measure HourlySpends = ```
			
			VAR CurrentHour = MAX('HIVEMINDS_FLIPKART_HOURLY_VIEW'[HOUR])
			VAR CurrentDate = SELECTEDVALUE('HIVEMINDS_FLIPKART_HOURLY_VIEW'[DATE])
			
			VAR CurrentSpends = 
			    CALCULATE(
			        SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[AD_SPEND]),
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[HOUR] = CurrentHour,
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[DATE] = CurrentDate
			    )
			
			VAR PrevSpends = 
			    CALCULATE(
			        SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[AD_SPEND]),
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[HOUR] = CurrentHour - 1,
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[DATE] = CurrentDate
			    )
			
			RETURN
			IF(
			    ISBLANK(PrevSpends),
			    CurrentSpends,  -- show full spend if no previous hour (i.e. 1st hour)
			    CurrentSpends - PrevSpends
			)
			
			```
		formatString: #,0
		lineageTag: aa2773f9-a31d-47f4-b103-b31dd862bebc

