	measure HourlyCTR = ```
			
			VAR CurrentHour = MAX('HIVEMINDS_FLIPKART_HOURLY_VIEW'[HOUR])
			VAR CurrentDate = SELECTEDVALUE('HIVEMINDS_FLIPKART_HOURLY_VIEW'[DATE])
			
			-- Current hour clicks & impressions
			VAR CurrentClicks = 
			    CALCULATE(
			        SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[CLICKS]),
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[HOUR] = CurrentHour,
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[DATE] = CurrentDate
			    )
			
			VAR CurrentImpr = 
			    CALCULATE(
			        SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[VIEWS]),
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[HOUR] = CurrentHour,
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[DATE] = CurrentDate
			    )
			
			-- Previous hour clicks & impressions
			VAR PrevClicks = 
			    CALCULATE(
			        SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[CLICKS]),
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[HOUR] = CurrentHour - 1,
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[DATE] = CurrentDate
			    )
			
			VAR PrevImpr = 
			    CALCULATE(
			        SUM('HIVEMINDS_FLIPKART_HOURLY_VIEW'[VIEWS]),
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[HOUR] = CurrentHour - 1,
			        'HIVEMINDS_FLIPKART_HOURLY_VIEW'[DATE] = CurrentDate
			    )
			
			-- Compute CTRs
			VAR CurrentCTR = DIVIDE(CurrentClicks, CurrentImpr)
			VAR PrevCTR = DIVIDE(PrevClicks, PrevImpr)
			
			RETURN
			IF(
			    ISBLANK(PrevCTR),
			    CurrentCTR,
			    CurrentCTR - PrevCTR
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0916e1f1-74e9-43cf-b8d4-81dfc5006911

