table 'public flipkart_buybox'
	lineageTag: 112e1e63-1dbb-4714-872c-69783df1de72

	measure '%instock F' = ```
			DIVIDE(
			    COUNTAX(FILTER('public flipkart_buybox', 'public flipkart_buybox'[availability] = "Instock"), 'public flipkart_buybox'[availability]),
			    COUNT('public flipkart_buybox'[availability]),
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 35d0bee6-b105-4e67-9d8f-d5e1605b63ce

	measure '%out of stock F' = ```
			DIVIDE(
			    COUNTAX(FILTER('public flipkart_buybox', 'public flipkart_buybox'[availability] = "Out Of Stock"), 'public flipkart_buybox'[availability]),
			    COUNT('public flipkart_buybox'[availability]),
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
