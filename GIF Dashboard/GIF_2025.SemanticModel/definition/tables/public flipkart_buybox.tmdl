	column City =
			
			IF('public flipkart_buybox'[pincode] = "110001", "New Delhi",
			    IF('public flipkart_buybox'[pincode] = "560001", "Bengaluru",
			        IF('public flipkart_buybox'[pincode] = "400001", "Mumbai",
			            IF('public flipkart_buybox'[pincode] = "500001", "Hyderabad",
			                IF('public flipkart_buybox'[pincode] = "700001", "Kolkata",
			                    BLANK()
			                )
			            )
			        )
			    )
			)
		lineageTag: 60b0379c-74d5-4844-b820-3af59d2ddc0c
		summarizeBy: none

