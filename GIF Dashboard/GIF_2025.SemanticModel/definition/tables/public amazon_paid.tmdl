	measure 'Status Flag' = ```
			
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('public amazon_paid'[Status]) = "CAMPAIGN_STATUS_ENABLED", "🟢",   -- Green circle
			    SELECTEDVALUE('public amazon_paid'[Status]) = "OUT_OF_BUDGET", "🔴",             -- Red circle
			    SELECTEDVALUE('public amazon_paid'[Status]) = "PORTFOLIO_ENDED", "🔵",           -- Blue circle
			    SELECTEDVALUE('public amazon_paid'[Status]) = "PORTFOLIO_OUT_OF_BUDGET", "🟡",   -- Yellow circle
			    BLANK()
			)
			
			```
