	measure HourlyCTR_A = ```
			
			VAR CurrentHour = MAX('public amazon_paid'[hour])
			VAR CurrentDate = SELECTEDVALUE('public amazon_paid'[date])
			
			-- Current hour clicks & impressions
			VAR CurrClicks =
			    CALCULATE(
			        SUM('public amazon_paid'[clicks]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrImpr =
			    CALCULATE(
			        SUM('public amazon_paid'[impressions]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrCTR = DIVIDE(CurrClicks, CurrImpr)
			
			-- Previous hour clicks & impressions
			VAR PrevClicks =
			    CALCULATE(
			        SUM('public amazon_paid'[clicks]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevImpr =
			    CALCULATE(
			        SUM('public amazon_paid'[impressions]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevCTR = DIVIDE(PrevClicks, PrevImpr)
			
			-- Return difference vs previous hour
			RETURN
			IF(
			    ISBLANK(PrevCTR),
			    CurrCTR,
			    CurrCTR - PrevCTR
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d3f957cd-f270-45bf-8e8e-f0a00314d5ad

	measure HourlyCPC_A = ```
			
			VAR CurrentHour = MAX('public amazon_paid'[hour])
			VAR CurrentDate = SELECTEDVALUE('public amazon_paid'[date])
			
			-- Current hour spend & clicks
			VAR CurrSpend =
			    CALCULATE(
			        SUM('public amazon_paid'[spend]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrClicks =
			    CALCULATE(
			        SUM('public amazon_paid'[clicks]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrCPC = DIVIDE(CurrSpend, CurrClicks)
			
			-- Previous hour spend & clicks
			VAR PrevSpend =
			    CALCULATE(
			        SUM('public amazon_paid'[spend]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevClicks =
			    CALCULATE(
			        SUM('public amazon_paid'[clicks]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevCPC = DIVIDE(PrevSpend, PrevClicks)
			
			-- Return difference like HourlyCVR
			RETURN
			IF(
			    ISBLANK(PrevCPC),
			    CurrCPC,
			    CurrCPC - PrevCPC
			)
			
			```
		lineageTag: 86b098a2-73c6-4dd8-9a87-ffd964bbf3b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure HourlyROAS_A = ```
			
			VAR CurrentHour = MAX('public amazon_paid'[hour])
			VAR CurrentDate = SELECTEDVALUE('public amazon_paid'[date])
			
			-- Current hour sales & spend
			VAR CurrSales =
			    CALCULATE(
			        SUM('public amazon_paid'[sales]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrSpend =
			    CALCULATE(
			        SUM('public amazon_paid'[spend]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrROAS = DIVIDE(CurrSales, CurrSpend)
			
			-- Previous hour sales & spend
			VAR PrevSales =
			    CALCULATE(
			        SUM('public amazon_paid'[sales]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevSpend =
			    CALCULATE(
			        SUM('public amazon_paid'[spend]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevROAS = DIVIDE(PrevSales, PrevSpend)
			
			-- Return difference vs previous hour
			RETURN
			IF(
			    ISBLANK(PrevROAS),
			    CurrROAS,
			    CurrROAS - PrevROAS
			)
			
			```
		lineageTag: 05782390-8260-43c1-9452-409c8d491d4a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure HourlyCVR_A = ```
			
			VAR CurrentHour = MAX('public amazon_paid'[hour])
			VAR CurrentDate = SELECTEDVALUE('public amazon_paid'[date])
			
			-- Current hour orders & clicks
			VAR CurrOrders =
			    CALCULATE(
			        SUM('public amazon_paid'[orders]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrClicks =
			    CALCULATE(
			        SUM('public amazon_paid'[clicks]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrCVR = DIVIDE(CurrOrders, CurrClicks)
			
			-- Previous hour orders & clicks
			VAR PrevOrders =
			    CALCULATE(
			        SUM('public amazon_paid'[orders]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevClicks =
			    CALCULATE(
			        SUM('public amazon_paid'[clicks]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevCVR = DIVIDE(PrevOrders, PrevClicks)
			
			-- Return difference like in your Hourly CVR screenshot
			RETURN
			IF(
			    ISBLANK(PrevCVR),
			    CurrCVR,
			    CurrCVR - PrevCVR
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 93eea952-d125-4c49-b8df-9a01c20e0823

	measure HourlyACOS_A = ```
			
			VAR CurrentHour = MAX('public amazon_paid'[hour])
			VAR CurrentDate = SELECTEDVALUE('public amazon_paid'[date])
			
			-- Current hour spend & sales
			VAR CurrSpend =
			    CALCULATE(
			        SUM('public amazon_paid'[spend]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrSales =
			    CALCULATE(
			        SUM('public amazon_paid'[sales]),
			        'public amazon_paid'[hour] = CurrentHour,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR CurrACOS = DIVIDE(CurrSpend, CurrSales)
			
			-- Previous hour spend & sales
			VAR PrevSpend =
			    CALCULATE(
			        SUM('public amazon_paid'[spend]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevSales =
			    CALCULATE(
			        SUM('public amazon_paid'[sales]),
			        'public amazon_paid'[hour] = CurrentHour - 1,
			        'public amazon_paid'[date] = CurrentDate
			    )
			
			VAR PrevACOS = DIVIDE(PrevSpend, PrevSales)
			
			-- Return difference vs previous hour
			RETURN
			IF(
			    ISBLANK(PrevACOS),
			    CurrACOS,
			    CurrACOS - PrevACOS
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0916f2df-3810-49d6-833a-acb3623fdba3

	measure HourlyAOV_A = ```
			
			VAR CurrentHour = MAX('public amazon_paid'[hour])
