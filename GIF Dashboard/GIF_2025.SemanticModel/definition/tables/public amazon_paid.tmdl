	measure HourlySpendByCategoryDateHour = ```
			
			VAR CurrentHour = SELECTEDVALUE('public amazon_paid'[hour])
			VAR CurrentDate = SELECTEDVALUE('public amazon_paid'[date])
			
			-- Spend for current hour, date, and category (filter comes from the visual via relationship)
			VAR SpendNow =
			    CALCULATE(
			        SUM('public amazon_paid'[spend]),
			        'public amazon_paid'[date] = CurrentDate,
			        'public amazon_paid'[hour] = CurrentHour
			    )
			
			-- Spend for previous hour
			VAR SpendPrev =
			    CALCULATE(
			        SUM('public amazon_paid'[spend]),
			        'public amazon_paid'[date] = CurrentDate,
			        'public amazon_paid'[hour] = CurrentHour - 1
			    )
			
			RETURN
			    SpendNow - COALESCE(SpendPrev, 0)
			
			```
