	partition Tercept_amazon_central_campaign = calculated
		mode: import
		source = ```
				UNION(SUMMARIZECOLUMNS('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[DATE],'HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[CAMPAIGN_NAME],
				'HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[HOUR],
				
				 "impressions",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[IMPRESSIONS]),
				 "clicks",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[IMPRESSIONS]),
				 "spends",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[COST]),
				 "orders",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[UNITS_SOLD]),
				 "sales",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[SALES])),
				
				 SUMMARIZECOLUMNS('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[DATE],'HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[CAMPAIGN_NAME],
				 'HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[HOUR],
				 
				 
				 "impressions",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[IMPRESSIONS]),
				 "clicks",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[CLICKS]),
				 "spends",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[COST]),
				 "orders",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[UNITS_SOLD]),
				 "sales",SUM('HIVEMINDS_AMAZON_SPONSORED_DISPLAY_HOURLY_VIEW'[SALES])),
				 
				 SUMMARIZECOLUMNS('HIVEMINDS_AMAZON_SPONSORED_PRODUCTS_HOURLY_VIEW'[DATE],'HIVEMINDS_AMAZON_SPONSORED_PRODUCTS_HOURLY_VIEW'[CAMPAIGN_NAME],
				 'HIVEMINDS_AMAZON_SPONSORED_PRODUCTS_HOURLY_VIEW'[HOUR],
				 "impressions",SUM('HIVEMINDS_AMAZON_SPONSORED_PRODUCTS_HOURLY_VIEW'[IMPRESSIONS]),
				 "clicks",SUM('HIVEMINDS_AMAZON_SPONSORED_PRODUCTS_HOURLY_VIEW'[CLICKS]),
				 "spends",sum('HIVEMINDS_AMAZON_SPONSORED_PRODUCTS_HOURLY_VIEW'[SPEND]),
				 "orders",SUM('HIVEMINDS_AMAZON_SPONSORED_PRODUCTS_HOURLY_VIEW'[SPEND]),
				 "sales",SUM('HIVEMINDS_AMAZON_SPONSORED_PRODUCTS_HOURLY_VIEW'[COST])
				 )
				 )
				```

